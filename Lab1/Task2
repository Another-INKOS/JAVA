package edu.course.lab1;

public class TextTask {
    public static String reverse (String s){ //принимает строку которую заранее вписали
        String result = ""; //пустая строка куда будет сохраняться каждый символ который будет взят у строки
        for (int i = s.length()-1; i>=0; i--){ //перебор символов от конца к началу 
            result += s.charAt(i);
        }
        return result;
    }
}
